{
  "name": "opennova",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "OpenNova voice and work assistant with bundled Harness and Bot source",
  "packageManager": "pnpm@11.28.5",
  "engines": {"node": ">=24 <25"},
  "scripts": {
