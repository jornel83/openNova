[
  {
    "type": "function",
    "function": {
      "name": "video_validate",
      "description": "Validate Seedance text/image-reference generation locally. No API call or charge.",
      "parameters": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt"
            ],
            "properties": {
              "model": {
                "type": "string",
                "default": "doubao-seedance-2-5-260628"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30000
              },
              "duration": {
                "type": "integer",
                "minimum": 4,
                "maximum": 30,
                "default": 10
              },
              "ratio": {
                "type": "string",
                "enum": [
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16",
                  "adaptive"
                ],
                "default": "9:16"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "720p",
                  "1080p"
                ],
                "default": "720p"
              },
              "generate_audio": {
                "type": "boolean",
                "default": true
              },
              "reference_images": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "config_path": {
            "type": "string",
            "description": "JSON file. Reference images/clip paths resolve relative to this file."
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "config"
            ],
            "not": {
              "required": [
                "config_path"
              ]
            }
          },
          {
            "required": [
              "config_path"
            ],
            "not": {
              "required": [
                "config"
              ]
            }
          }
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "video_submit",
      "description": "Submit exactly one billable Seedance task; returns immediately. Requires prior user authorization and ARK_API_KEY in executor environment. Do not retry ambiguous submission.",
      "parameters": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt"
            ],
            "properties": {
              "model": {
                "type": "string",
                "default": "doubao-seedance-2-5-260628"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30000
              },
              "duration": {
                "type": "integer",
                "minimum": 4,
                "maximum": 30,
                "default": 10
              },
              "ratio": {
                "type": "string",
                "enum": [
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16",
                  "adaptive"
                ],
                "default": "9:16"
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "720p",
                  "1080p"
                ],
                "default": "720p"
              },
              "generate_audio": {
                "type": "boolean",
                "default": true
              },
              "reference_images": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "config_path": {
            "type": "string",
            "description": "JSON file. Reference images/clip paths resolve relative to this file."
          },
          "output_dir": {
            "type": "string",
            "description": "Per-task directory; task.json guards duplicate submissions."
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "config"
            ],
            "not": {
              "required": [
                "config_path"
              ]
            }
          },
          {
            "required": [
              "config_path"
            ],
            "not": {
              "required": [
                "config"
              ]
            }
          }
        ],
        "required": [
          "output_dir"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "video_status",
      "description": "Query one existing Ark task, persist status. No generation submission.",
      "parameters": {
        "type": "object",
        "properties": {
          "output_dir": {
            "type": "string",
            "description": "Per-task directory; task.json guards duplicate submissions."
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "additionalProperties": false,
        "required": [
          "output_dir"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "video_wait",
      "description": "Poll an existing task for a bounded duration; timeout returns current status, not a new task.",
      "parameters": {
        "type": "object",
        "properties": {
          "output_dir": {
            "type": "string",
            "description": "Per-task directory; task.json guards duplicate submissions."
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "poll_seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 60,
            "default": 15
          },
          "timeout_seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 3600,
            "default": 60
          }
        },
        "additionalProperties": false,
        "required": [
          "output_dir"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "video_download",
      "description": "Download succeeded task as a local MP4; refuses overwrite.",
      "parameters": {
        "type": "object",
        "properties": {
          "output_dir": {
            "type": "string",
            "description": "Per-task directory; task.json guards duplicate submissions."
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "filename": {
            "type": "string",
            "default": "video.mp4",
            "description": "MP4 basename; no directory separators."
          }
        },
        "additionalProperties": false,
        "required": [
          "output_dir"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "video_edit",
      "description": "Trim and concatenate ordered local clips with FFmpeg, normalize size/FPS/audio. dry_run only probes and returns timeline.",
      "parameters": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "clips",
              "output"
            ],
            "properties": {
              "clips": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  }
                }
              },
              "output": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 2,
                "maximum": 3840,
                "multipleOf": 2,
                "default": 720
              },
              "height": {
                "type": "integer",
                "minimum": 2,
                "maximum": 3840,
                "multipleOf": 2,
                "default": 1280
              },
              "fps": {
                "type": "number",
                "minimum": 1,
                "maximum": 60,
                "default": 24
              },
              "crf": {
                "type": "number",
                "minimum": 0,
                "maximum": 51,
                "default": 18
              }
            }
          },
          "config_path": {
            "type": "string",
            "description": "JSON file. Reference images/clip paths resolve relative to this file."
          },
          "dry_run": {
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "config"
            ],
            "not": {
              "required": [
                "config_path"
              ]
            }
          },
          {
            "required": [
              "config_path"
            ],
            "not": {
              "required": [
                "config"
              ]
            }
          }
        ]
      }
    }
  }
]
