[
  {
    "type": "function",
    "function": {
      "name": "video_validate",
      "description": "Validate a Seedance, Minimax H3 or Spark P2 generation config offline. Ark checks asset permissions at submission.",
      "parameters": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "prompt"
            ],
            "properties": {
              "model": {
                "type": "string",
                "description": "Seedance is the default. Use an enabled Ark model or endpoint ID, minimax-h3-veda for local Minimax H3, or minimax-h3-spark for the P2 first-frame profile."
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30000
              },
              "duration": {
                "type": "integer",
                "minimum": 4,
                "maximum": 30,
                "default": 10,
                "description": "Spark defaults to 4 seconds. Minimax H3 text and first-frame generation accept integer durations from 4 to 15 seconds. P2 first-frame generation accepts 4, 5 or 6 seconds."
              },
              "ratio": {
                "type": "string",
                "enum": [
                  "21:9",
                  "16:9",
                  "4:3",
                  "1:1",
                  "3:4",
                  "9:16",
                  "adaptive"
                ],
                "description": "Defaults to 9:16 for text/reference generation, adaptive for first_frame. Seedance 2.5 first-frame requests require adaptive."
              },
              "resolution": {
                "type": "string",
                "enum": [
                  "480p",
                  "720p",
                  "1080p"
                ],
                "default": "720p"
              },
              "generate_audio": {
                "type": "boolean",
                "default": true
              },
              "reference_images": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string"
                }
              },
              "reference_videos": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string"
                },
                "description": "Local MP4/MOV paths; uploaded to official Ark Files at submit."
              },
              "omni_reference_task_type": {
                "type": "string",
                "enum": [
                  "reference"
                ],
                "description": "Only new reference-based generation is supported."
              },
              "first_frame": {
                "type": "string",
                "pattern": "^asset://asset-[A-Za-z0-9_-]+$",
                "description": "Approved Ark portrait asset URI used as role=first_frame. Requires an explicit enabled model. Mutually exclusive with nonempty reference_images/reference_videos and omni_reference_task_type. Offline validation does not verify account ownership or asset approval. In first-frame mode ratio defaults to adaptive; Seedance 2.5 requires adaptive. Seedance 2.0 duration is 4–15 seconds; 2.0 Fast supports 480p/720p.",
                "maxLength": 256
              },
              "watermark": {
                "type": "boolean",
                "description": "Forward the explicit watermark setting to Ark; omitted keeps the provider default."
              },
              "return_last_frame": {
                "type": "boolean",
                "description": "Ask Ark to return the generated last-frame URL in the saved task record; does not download that image."
              },
              "first_frame_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "A local PNG/JPEG first frame for Seedance, Minimax H3 or P2. Resolve relative paths from the config file or workspace."
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647,
                "description": "Spark H3 random seed; defaults to 1101."
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "first_frame"
                  ]
                },
                "then": {
                  "required": [
                    "model"
                  ],
                  "properties": {
                    "model": {
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "reference_images": {
                      "maxItems": 0
                    },
                    "reference_videos": {
                      "maxItems": 0
                    }
                  },
                  "not": {
                    "required": [
                      "omni_reference_task_type"
                    ]
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "model": {
                            "pattern": "^doubao-seedance-2-0-"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "duration": {
                            "maximum": 15
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "model": {
                            "pattern": "^doubao-seedance-2-0-fast-"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "resolution": {
                            "enum": [
                              "480p",
                              "720p"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "model": {
                            "pattern": "^doubao-seedance-2-5-"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "ratio": {
                            "const": "adaptive"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              {
                "if": {
                  "required": [
                    "model"
                  ],
                  "properties": {
                    "model": {
                      "enum": [
                        "minimax-h3-spark",
                        "minimax-h3-veda"
                      ]
                    }
                  }
                },
                "then": {
                  "propertyNames": {
                    "enum": [
                      "model",
                      "first_frame_path",
                      "prompt",
                      "duration",
                      "ratio",
                      "seed"
                    ]
                  },
                  "properties": {
                    "ratio": {
                      "const": "9:16"
                    }
                  }
                },
                "else": {
                  "not": {
                    "required": [
                      "seed"
                    ]
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "model"
                  ],
                  "properties": {
                    "model": {
                      "const": "minimax-h3-veda"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "duration": {
                      "minimum": 4,
                      "maximum": 15
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "model"
                  ],
                  "properties": {
                    "model": {
                      "const": "minimax-h3-spark"
                    }
                  }
                },
                "then": {
                  "required": [
                    "first_frame_path"
                  ],
                  "properties": {
                    "duration": {
                      "enum": [
                        4,
                        5,
                        6
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "first_frame_path"
                  ],
                  "not": {
                    "required": [
                      "model"
                    ],
                    "properties": {
                      "model": {
                        "enum": [
                          "minimax-h3-spark",
                          "minimax-h3-veda"
                        ]
                      }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reference_images": {
                      "maxItems": 0
                    },
                    "reference_videos": {
                      "maxItems": 0
                    }
                  },
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "first_frame"
                        ]
                      },
                      {
                        "required": [
                          "omni_reference_task_type"
                        ]
                      }
                    ]
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "model": {
                            "pattern": "^doubao-seedance-2-0-"
                          }
                        },
                        "required": [
                          "model"
                        ]
                      },
                      "then": {
                        "properties": {
                          "duration": {
                            "maximum": 15
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "model": {
                            "pattern": "^doubao-seedance-2-0-fast-"
                          }
                        },
                        "required": [
                          "model"
                        ]
                      },
                      "then": {
                        "properties": {
                          "resolution": {
                            "enum": [
                              "480p",
                              "720p"
                            ]
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "model": {
                            "pattern": "^doubao-seedance-2-5-"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "ratio": {
                            "const": "adaptive"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "config_path": {
            "type": "string",
            "description": "JSON file. Reference images/clip paths resolve relative to this file."
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "config"
            ],
            "not": {
              "required": [
                "config_path"
              ]
            }
          },
          {
            "required": [
              "config_path"
            ],
            "not": {
              "required": [
                "config"
              ]
            }
          }
        ]
      }
    }
  },
